---
// ✅ [FEATURE]: GuideLayout — article wrapper for /guides (SEO + Article/FAQ schema + brand CTA).
// Goes at: src/layouts/GuideLayout.astro
import Base from './Base.astro';
import SiteHeader from '../components/SiteHeader.astro'; // ✅ [FEATURE]: sticky brand bar (Batch 6, F-19)
import AppCta from '../components/AppCta.astro'; // ✅ [FEATURE]: shared install card (also used by /blog)
import '../styles/prose.css'; // ✅ [FEATURE]: shared prose styles, moved out of this file
import { AUTHOR, personId, personSchema } from '../data/author';
import { getCollection } from 'astro:content'; // ✅ [FEATURE]: fetch related-guide entries (Batch 5)

interface Props {
  title: string;
  displayTitle?: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  heroImage?: string;
  heroImageAlt?: string;
  tags?: string[];
  pillar?: boolean;
  faqs?: { q: string; a: string }[];
  related?: string[]; // ✅ [FEATURE]: sibling guide slugs, powers the "Keep reading" block
  slug: string;
}

const {
  title,
  displayTitle,
  description,
  pubDate,
  updatedDate,
  heroImage,
  heroImageAlt,
  tags = [],
  pillar = false,
  faqs = [],
  related = [],
  slug,
} = Astro.props;

const site = Astro.site ?? new URL('https://havyu.org');
const origin = site.origin;
const canonicalPath = `/guides/${slug}`;
const url = new URL(canonicalPath, site).href;

// ✅ [FEATURE]: "Keep reading" data — fetch the guides named in `related`,
// preserving the order given and silently skipping any slug that doesn't
// resolve (self-heals against a typo rather than failing the build).
const relatedGuides =
  related.length > 0
    ? (
        await getCollection('guides', ({ id, data }) => !data.draft && related.includes(id))
      ).sort((a, b) => related.indexOf(a.id) - related.indexOf(b.id))
    : [];

const published = pubDate.toISOString();
const modified = (updatedDate ?? pubDate).toISOString();
const dateLabel = (updatedDate ?? pubDate).toLocaleDateString('en-GB', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

// ✅ [FEATURE]: BlogPosting schema — author = the same Person entity as the site (E-E-A-T).
const articleSchema: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: published,
  dateModified: modified,
  ...(heroImage ? { image: new URL(heroImage, site).href } : {}),
  author: { '@type': 'Person', '@id': personId(origin), name: AUTHOR.name, url: origin },
  publisher: {
    '@type': 'Organization',
    name: 'Havyu', // ✅ [FIX]: brand renamed (dropped "AI") with v2.0.0
    url: origin,
    logo: { '@type': 'ImageObject', url: new URL('/apple-touch-icon.png', site).href },
  },
  mainEntityOfPage: { '@type': 'WebPage', '@id': url },
  url,
};

const faqSchema =
  faqs.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: faqs.map((f) => ({
          '@type': 'Question',
          name: f.q,
          acceptedAnswer: { '@type': 'Answer', text: f.a },
        })),
      }
    : null;

const h1 = displayTitle ?? title;

// ✅ [FEATURE]: BreadcrumbList schema (Batch 5) — Home → Guides → this article.
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: origin },
    { '@type': 'ListItem', position: 2, name: 'Guides', item: new URL('/guides', site).href },
    { '@type': 'ListItem', position: 3, name: h1, item: url },
  ],
};

const schema = [
  articleSchema,
  personSchema(origin),
  breadcrumbSchema,
  ...(faqSchema ? [faqSchema] : []),
];

const ogImage = heroImage ?? '/og-image.png';
const ogAlt = heroImageAlt ?? 'Havyu — AI weightlifting and recovery coach'; // ✅ [FIX]: new descriptor (Oct 2026)
---

<Base
  title={`${title} — Havyu`}
  description={description}
  canonicalPath={canonicalPath}
  ogImage={ogImage}
  ogImageAlt={ogAlt}
  ogType="article"
  schema={schema}
>
  <SiteHeader />
  <article class="mx-auto max-w-3xl px-6 py-12 md:py-16">
    <a href="/guides" class="text-sm font-semibold text-forest transition hover:text-forest-deep">
      ← All guides
    </a>

    <div class="mt-6 flex flex-wrap items-center gap-2">
      {pillar && (
        // ✅ [FIX]: was bg-ai/10 text-ai — this badge marks reading order, not
        // AI-generated content, so it shouldn't use the AI-reserved purple token.
        <span class="rounded-full bg-leaf/10 px-3 py-1 text-xs font-bold text-leaf">{/* ✅ [FIX]: sentence case (DESIGN_SYSTEM §3) */}
          Start here
        </span>
      )}
      {tags.map((t) => (
        <span class="rounded-full bg-surface px-3 py-1 text-xs font-semibold text-espresso/60 ring-1 ring-border">
          {t}
        </span>
      ))}
    </div>

    <h1 class="mt-4 font-display text-3xl font-black leading-tight tracking-tight text-espresso md:text-4xl">
      {h1}
    </h1>
    <p class="mt-4 text-lg leading-relaxed text-espresso/70">{description}</p>

    {/* ✅ [FIX]: byline as a plain sentence (was a middle-dot meta string) */}
    <p class="mt-5 text-sm text-espresso/60">
      By <span class="font-semibold text-espresso/80">{AUTHOR.name}</span>, developer of Havyu.
      <time datetime={modified}>{dateLabel}</time>.
    </p>

    {heroImage && (
      <img
        src={heroImage}
        alt={heroImageAlt ?? ''}
        width="1200"
        height="675"
        class="mt-8 aspect-[16/9] w-full rounded-3xl object-cover shadow-card"
      />
    )}

    <div class="guide-prose mt-10">
      <slot />
    </div>

    {faqs.length > 0 && (
      <section class="mt-14">
        <h2 class="font-display text-2xl font-black tracking-tight text-espresso">Common questions</h2>
        <div class="mt-5 divide-y divide-border overflow-hidden rounded-3xl border border-border bg-surface">
          {faqs.map((f) => (
            <details class="group p-5">
              <summary class="cursor-pointer list-none font-display text-lg font-bold text-espresso [&::-webkit-details-marker]:hidden">
                {f.q}
              </summary>
              <p class="mt-2 leading-relaxed text-espresso/70">{f.a}</p>
            </details>
          ))}
        </div>
      </section>
    )}

    {relatedGuides.length > 0 && (
      // ✅ [FEATURE]: "Keep reading" — Batch 5 cluster-linking. Sits after the
      // FAQ and before the CTA so the CTA stays the final element on the page.
      <section class="mt-14">
        <h2 class="font-display text-2xl font-black tracking-tight text-espresso">Keep reading</h2>
        <div class="mt-5 grid gap-4 sm:grid-cols-3">
          {relatedGuides.map((g) => (
            <a
              href={`/guides/${g.id}`}
              class="group flex flex-col overflow-hidden rounded-2xl border border-border bg-surface shadow-card transition hover:-translate-y-1"
            >
              {g.data.heroImage && (
                <img
                  src={g.data.heroImage}
                  alt=""
                  width="1200"
                  height="675"
                  loading="lazy"
                  class="aspect-[16/9] w-full object-cover"
                />
              )}
              <div class="p-4">
                <p class="text-sm font-bold leading-snug text-espresso transition group-hover:text-forest">
                  {g.data.displayTitle ?? g.data.title}
                </p>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}

    {/* ✅ [FEATURE]: brand CTA — now the shared AppCta component */}
    <AppCta />
  </article>
</Base>

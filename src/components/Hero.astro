---
// ✅ [FEATURE]: Hero — the brand field (Oct 2026 rebuild to match the app).
// Goes at: src/components/Hero.astro
// ✅ [FIX]: background is now the app's BRAND_FIELD gradient (entry screen +
// paywall) via the `bg-field` utility, replacing the rotating radial blobs and
// their hardcoded hexes. The page's one motion moment will be the hero loop
// video (Batch F), so the background itself stays still.
// ✅ [FIX]: purple kicker retired (AI wears the pillar colour) → Mint on green.
// ✅ [FIX]: ALL-CAPS tracked labels → sentence case (DESIGN_SYSTEM §3).
import StoreButtons from './StoreButtons.astro';
import { HAVYU_LINKS } from '../data/author';
---

<header class="bg-field">
  <div class="mx-auto max-w-6xl px-6">
    {/* ✅ [FIX]: hero lockup removed — the sticky SiteHeader directly above already
        carries the mark + wordmark, so the first frame no longer repeats it. */}
    <div class="pt-14 pb-20 md:pt-24 md:pb-28">
      <p class="text-base font-bold text-mint">AI weightlifting and recovery coach</p>
      <h1
        class="mt-4 max-w-4xl font-display text-4xl font-black leading-[1.05] tracking-tight text-white sm:text-5xl md:text-6xl"
      >
        Havyu connects the dots.<br class="hidden sm:block" /> You lift with absolute certainty.
      </h1>
      {/* ✅ [FIX]: reworded (owner, Oct 2026) — was "…tells you what to do next — so
          you walk in knowing exactly what to lift". Havyu observes; it tells you
          WHEN to add weight, from your own performance and recovery. */}
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-white/85">
        Havyu watches how you train and how you recover, connects the two, and tells you
        when to up the weight, based on your own performance and recovery.
      </p>
      <div class="mt-9">
        <StoreButtons variant="onDark" appStoreUrl={HAVYU_LINKS.appStore} />
      </div>

      {/* In-page jump links (dwell time). ✅ [FIX]: dropped the "EXPLORE" caps label. */}
      <nav
        aria-label="Jump to section"
        class="mt-12 flex flex-wrap items-center gap-x-6 gap-y-2 border-t border-white/15 pt-6 text-sm font-semibold text-white/75"
      >
        <a href="#ecosystem" class="transition hover:text-white">Ecosystem</a>
        <a href="#intelligence" class="transition hover:text-white">Intelligence</a>
        <a href="#see-it" class="transition hover:text-white">See it</a>
        <a href="#faq" class="transition hover:text-white">FAQ</a>
        <a href="/guides" class="transition hover:text-white">Guides</a>
        <a href="/blog" class="transition hover:text-white">Blog</a>
      </nav>
    </div>
  </div>
</header>

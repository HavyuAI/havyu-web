---
// ✅ [FEATURE]: "See it in action" — app screenshots in a horizontal swipe carousel.
// Goes at: src/components/Showcase.astro
// Assets: copy the four .webp files into  public/screenshots/
// Carousel = native CSS scroll-snap (touch swipe) + arrow buttons (desktop). No deps.
// ✅ [FIX] (Batch E): kicker tone is the PILLAR colour — 'train' = Chestnut,
// 'recover' = Deep Leaf. The purple 'ai' tone is retired (AI wears the pillar colour).
// ✅ [FEATURE]: v2 screenshots (Oct 2026, app v2.0.0) — Training first, then
// Recovery, led by the highest-value features: live overload coaching, then
// Ask the coach (owner, Oct 2026). Kicker tone = pillar: 'train' → Chestnut, 'recover' → Deep Leaf.
const S = { w: 600, h: 1336 };
const shots = [
  { src: '/screenshots/v2-live-overload.webp', ...S, tone: 'train', kicker: 'Live overload coaching', caption: 'Mid-workout: whether to add weight, hold, or ease back.' },
  { src: '/screenshots/v2-ask-coach-training.webp', ...S, tone: 'train', kicker: 'Ask the coach', caption: 'Questions about your training, answered from your sessions.' },
  { src: '/screenshots/v2-todays-focus.webp', ...S, tone: 'train', kicker: 'Today’s focus', caption: 'Before you train: what has stalled, and how last night should shape today.' },
  { src: '/screenshots/v2-coaching-insights.webp', ...S, tone: 'train', kicker: 'Coaching insights', caption: 'Patterns in your own lifts, explained in plain language.' },
  { src: '/screenshots/v2-daily-have-you.webp', ...S, tone: 'recover', kicker: 'The “Have you…?” check-in', caption: 'Flick through your recovery habits in seconds.' },
  { src: '/screenshots/v2-ask-coach-recovery.webp', ...S, tone: 'recover', kicker: 'Ask the recovery coach', caption: 'How your sleep, protein and water line up with your lifting.' },
  { src: '/screenshots/v2-grounded-in-science.webp', ...S, tone: 'recover', kicker: 'Grounded in science', caption: 'Your targets checked against the research, with the study named.' },
  { src: '/screenshots/v2-progress.webp', ...S, tone: 'train', kicker: 'Progress', caption: 'Your North Star lift, this week’s volume and the coach’s read on your block.' },
];
---

<section id="see-it" class="bg-surface-warm">
  <div class="mx-auto max-w-6xl px-6 py-16 md:py-24" data-hv-carousel>
    <div class="flex items-end justify-between gap-4">
      <div>
        <h2 class="font-display text-3xl font-black tracking-tight text-espresso md:text-4xl">
          See it in action.
        </h2>
        <p class="mt-4 max-w-2xl leading-relaxed text-espresso/70">
          Real screens from Havyu: the Training coach, live overload calls on the gym
          floor, and the Recovery check-in that feeds them.
        </p>
      </div>

      {/* Arrows — desktop affordance; mobile users just swipe */}
      <div class="hidden shrink-0 gap-2 sm:flex">
        <button
          type="button"
          data-hv-prev
          aria-label="Previous screenshot"
          class="hv-arrow"
        >
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" aria-hidden="true">
            <path d="M15 6l-6 6 6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
        <button
          type="button"
          data-hv-next
          aria-label="Next screenshot"
          class="hv-arrow"
        >
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" aria-hidden="true">
            <path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
      </div>
    </div>

    <div class="hv-track mt-12" data-hv-track>
      {
        shots.map((s) => (
          <figure class="hv-slide flex flex-col items-center">
            <div class="device">
              <span class="device-speaker" aria-hidden="true" />
              <img
                src={s.src}
                width={s.w}
                height={s.h}
                loading="lazy"
                decoding="async"
                alt={s.kicker + ' — Havyu screenshot'}
                class="device-screen"
              />
              <span class="device-home" aria-hidden="true" />
            </div>
            <figcaption class="mt-5 text-center">
              <p
                class:list={[
                  'text-sm font-bold',
                  s.tone === 'train' ? 'text-chestnut' : 'text-leaf',
                ]}
              >
                {s.kicker}
              </p>
              <p class="mt-1 text-sm leading-relaxed text-espresso/70">{s.caption}</p>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* ---- Carousel track (native scroll-snap, touch swipe, hidden scrollbar) ---- */
  .hv-track {
    display: flex;
    gap: 24px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-left: 4px;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none; /* Firefox */
    padding-bottom: 8px; /* room for device shadow */
  }
  .hv-track::-webkit-scrollbar {
    display: none; /* WebKit */
  }
  .hv-slide {
    flex: 0 0 auto;
    width: clamp(210px, 76vw, 250px);
    scroll-snap-align: center;
  }

  /* ---- Arrow buttons ---- */
  .hv-arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 9999px;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    color: var(--color-espresso);
    box-shadow: var(--shadow-card);
    transition:
      transform 0.15s ease,
      background 0.15s ease;
  }
  .hv-arrow:hover {
    transform: translateY(-1px);
    background: var(--color-surface);
  }
  .hv-arrow:active {
    transform: translateY(0);
  }

  /* ---- CSS phone mockup — bezel, side buttons, speaker + home indicator ---- */
  .device {
    position: relative;
    width: 100%;
    max-width: 270px;
    padding: 22px 11px;
    border-radius: 2.6rem;
    /* ✅ [FIX]: bezel from tokens (Espresso → app dark bg), was hardcoded hex */
    background: linear-gradient(150deg, var(--color-espresso) 0%, var(--color-night) 100%);
    box-shadow:
      0 18px 40px color-mix(in srgb, var(--color-espresso) 28%, transparent),
      inset 0 0 0 1.5px rgba(255, 255, 255, 0.06);
  }
  .device::before,
  .device::after {
    content: '';
    position: absolute;
    border-radius: 9999px;
    background: linear-gradient(180deg, var(--color-espresso), var(--color-night));
  }
  .device::before {
    right: -2px;
    top: 33%;
    width: 3px;
    height: 56px;
  }
  .device::after {
    left: -2px;
    top: 26%;
    width: 3px;
    height: 88px;
  }
  .device-screen {
    display: block;
    width: 100%;
    border-radius: 1.55rem;
    background: var(--color-night);
  }
  .device-speaker {
    position: absolute;
    top: 9px;
    left: 50%;
    transform: translateX(-50%);
    width: 34%;
    height: 5px;
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.16);
  }
  .device-home {
    position: absolute;
    bottom: 9px;
    left: 50%;
    transform: translateX(-50%);
    width: 30%;
    height: 4px;
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.14);
  }

  @media (prefers-reduced-motion: reduce) {
    .hv-track {
      scroll-behavior: auto;
    }
  }
</style>

<script>
  // ✅ [FEATURE]: arrow-button scrolling for the screenshot carousel (no deps)
  document.querySelectorAll('[data-hv-carousel]').forEach((root) => {
    const track = root.querySelector('[data-hv-track]');
    if (!track) return;
    const step = () => {
      const slide = track.querySelector('.hv-slide');
      const gap = 24;
      return slide ? slide.getBoundingClientRect().width + gap : track.clientWidth * 0.8;
    };
    root
      .querySelector('[data-hv-prev]')
      ?.addEventListener('click', () => track.scrollBy({ left: -step(), behavior: 'smooth' }));
    root
      .querySelector('[data-hv-next]')
      ?.addEventListener('click', () => track.scrollBy({ left: step(), behavior: 'smooth' }));
  });
</script>

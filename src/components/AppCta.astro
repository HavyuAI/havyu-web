---
// ✅ [FEATURE]: AppCta — the Havyu install card, shared by guides and blog.
// Goes at: src/components/AppCta.astro
// `full` = closing sign-off card (was inline in GuideLayout).
// `compact` = slim card under an article's short answer (SensAI-style top CTA).
import StoreButtons from './StoreButtons.astro';
import { HAVYU_LINKS } from '../data/author';

interface Props {
  variant?: 'full' | 'compact';
  /** Show Google Play first — for Android-led articles. */
  playFirst?: boolean;
}
const { variant = 'full', playFirst = false } = Astro.props;
// ✅ [FIX] (Batch E): no purple, no caps kicker, no "→" link suffix.
---

{variant === 'compact' ? (
  <aside class="mt-8 flex flex-col gap-4 rounded-3xl border border-border bg-surface p-5 shadow-card sm:flex-row sm:items-center sm:justify-between">
    <div class="flex items-center gap-3">
      <img
        src="/apple-touch-icon.png"
        alt=""
        aria-hidden="true"
        width="44"
        height="44"
        class="h-11 w-11 shrink-0 rounded-xl"
      />
      <div class="min-w-0 leading-tight">
        <p class="font-display font-extrabold text-espresso">Havyu</p>
        <p class="text-sm text-espresso/60">AI weightlifting and recovery coach. Free on iOS and Android.</p>
      </div>
    </div>
    <StoreButtons variant="onLight" appStoreUrl={HAVYU_LINKS.appStore} playFirst={playFirst} />
  </aside>
) : (
  /* ✅ [FIX]: closing card is the brand field (the app's entry/paywall gradient)
     instead of a purple wash — heavy on green, white type, white store badges. */
  <aside class="mt-14 overflow-hidden rounded-3xl bg-field p-8 text-white shadow-md">
    <div class="flex items-center gap-4">
      <img src="/havyu-mark.png" alt="" aria-hidden="true" width="604" height="419" loading="lazy" class="h-10 w-auto" />
      <div class="min-w-0">
        <p class="font-display text-2xl font-extrabold leading-tight text-white">Havyu</p>
        <p class="text-sm font-bold text-mint">Train. Recover. Overload.</p>
      </div>
    </div>
    <p class="mt-5 text-lg leading-relaxed text-white/85">
      Havyu watches both sides of your progress, your training and your recovery, and
      tells you when you're ready to add weight.
    </p>
    <div class="mt-6">
      <StoreButtons variant="onDark" appStoreUrl={HAVYU_LINKS.appStore} playFirst={playFirst} />
    </div>
    <a href="/" class="mt-5 inline-block text-sm font-semibold text-white underline underline-offset-4 transition hover:text-mint">
      See how Havyu works
    </a>
  </aside>
)}
